\def\@@rubrichead#1{%
  \begin{tikzpicture}[baseline]%
  \shade[left color=MarkerColour!8!white, right color=SwishLineColour!55!white] rectangle (\@almosttextwidth,2.5pt);
  \node[font={\@rubricfont},inner sep=0pt,text ragged,anchor=south west,text depth=.45ex,text height=1.35ex] at (1pt,2pt) {#1};
  \end{tikzpicture}%
  \vspace\rubricspace%
}





